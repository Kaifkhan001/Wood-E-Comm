# Copy to .env.local and fill in. Never commit real values.

# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Neon pooled connection string, or any Postgres) ──
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ── Auth (Better Auth) ───────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth — console.cloud.google.com → Credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (admin image uploads) ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Rate limiting (Upstash Redis) — required in production ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Bot protection (Cloudflare Turnstile) — optional but recommended ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email (Resend) — password reset + notifications ──
RESEND_API_KEY=
EMAIL_FROM="Aangan Living <hello@yourdomain.in>"
OWNER_NOTIFY_EMAIL=

# ── Analytics (GA4). Loads only after cookie consent. ──
NEXT_PUBLIC_GA_ID=

# ── Business contact ─────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=919800000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.in
NEXT_PUBLIC_CONTACT_PHONE=+91 98000 00000
